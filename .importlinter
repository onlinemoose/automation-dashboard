[importlinter]
root_package = dashboard
include_external_packages = True

[importlinter:contract:no-orchestration-framework]
name = The dashboard must not import an orchestration framework
type = forbidden
source_modules =
    dashboard
forbidden_modules =
    prefect
    dagster
    airflow
    celery

# The "front door only" rule (no `capability._core` imports) can't be
# expressed here without listing every capability by name. It is enforced
# in tests/test_guardrails.py instead.
