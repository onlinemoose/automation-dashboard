# Copy to `.env` (gitignored) and fill in.

# Session-cookie signing key. Any long random string. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Offline/dev login only — production auth is Supabase (see
# SUPABASE_ANON_KEY below). Used when SUPABASE_ANON_KEY is blank: the
# password is checked against this scrypt hash. Generate one:
#   uv run python -m dashboard.hashpw
DASHBOARD_PASSWORD_HASH=

# The email the offline/dev login accepts, matched case-insensitively.
# Only used when SUPABASE_ANON_KEY is blank; ignored in production.
# Defaults to operator@example.com.
DASHBOARD_DEV_EMAIL=

# Passed through the environment to any capability that calls an LLM.
ANTHROPIC_API_KEY=

# Backing store for the Background documents area (docs/BACKGROUND_DOCUMENTS.md).
# From the Supabase project: Settings -> API. The service_role key is full
# access — server-side only, never sent to the browser. Leave both blank to
# use an in-memory store that does not survive a restart (fine for local dev).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Supabase Auth: the anon (publishable) key, used for the email + password
# sign-in. Safe to hold server-side, but like every key here it is never
# committed — .env is gitignored. Set it (with SUPABASE_URL) to get real
# accounts; leave it blank to fall back to the offline login above.
# Accounts are pre-created in the Supabase dashboard — public signup is off.
SUPABASE_ANON_KEY=

# Set to 1 when served over HTTPS (marks the session cookie Secure).
DASHBOARD_HTTPS=0

# Set to 1 to click through the app without calling any capability: every
# run returns that page's canned `example_output`. No API key, no cost, no
# wait. A banner shows while it's on. Leave at 0 for real runs.
DASHBOARD_STUB_RUNS=0

# Optional host/port for `uv run dashboard` (defaults: 127.0.0.1:8000).
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8000
