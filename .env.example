# Copy to `.env` (gitignored) and fill in.

# Session-cookie signing key. Any long random string. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Offline/dev login only — production auth is Supabase (see
# SUPABASE_ANON_KEY below). Used when SUPABASE_ANON_KEY is blank: the
# password is checked against this scrypt hash. Generate one:
#   uv run python -m dashboard.hashpw
DASHBOARD_PASSWORD_HASH=

# The email the offline/dev login accepts, matched case-insensitively.
# Only used when SUPABASE_ANON_KEY is blank; ignored in production.
# Defaults to operator@example.com.
DASHBOARD_DEV_EMAIL=

# Offline-login only (SUPABASE_ANON_KEY unset): the dev user's allowed
# areas, comma-separated. Unset = all areas. Empty = none. See docs/ACCESS.md.
# Keys: job_application, content_creation_team
#   DASHBOARD_DEV_AREAS=job_application
DASHBOARD_DEV_AREAS=

# Passed through the environment to any capability that calls an LLM.
ANTHROPIC_API_KEY=

# Content Creation Team area — optional. `1` runs every stage on the
# cheapest model with no extended thinking: a wiring check, not a quality
# setting. Per-stage model overrides (CONTENT_TEAM_{SEO_BRIEF,RESEARCHER,
# COPYWRITER,EDITOR,SEO_REVIEW}_MODEL) and CONTENT_TEAM_CACHE_TTL also
# exist — see docs/CONTENT_BRIEFS.md. Not form inputs.
# CONTENT_TEAM_FAST=0

# Content Creation Team -> "Publish to website" (docs/CONTENT_BRIEFS.md).
# Both are this area's own config at the app edge (CLAUDE.md rule 7);
# either one missing surfaces as a visible error in the publish panel,
# never a silent no-op.
#
# FELDKLANG_GH_TOKEN — a dedicated fine-grained GitHub PAT for the area's
# outbound commit client (_feldklang_repo.py), which pushes the .mdx +
# hero image that publish-to-website returns to onlinemoose/feldklang.
# Repository access limited to onlinemoose/feldklang only; permission
# Contents: Read and write and nothing else. Not a GH_TOKEN fallback.
# See docs/DEPLOYMENT_CHECKLIST.md.
FELDKLANG_GH_TOKEN=
#
# RECRAFT_API_TOKEN — Recraft API token (https://www.recraft.ai/), used
# by the publish-to-website capability for hero-image generation. The
# capability reads it straight from os.environ; installed here as a
# pinned dependency it has no .env of its own at runtime, so the token
# must be set in this app's environment too — in addition to
# publish-to-website's own .env, which only covers standalone cli.py
# runs there. Each app reads its own environment.
RECRAFT_API_TOKEN=

# Backing store for the Background documents area (docs/BACKGROUND_DOCUMENTS.md).
# From the Supabase project: Settings -> API. The service_role key is full
# access — server-side only, never sent to the browser. Leave both blank to
# use an in-memory store that does not survive a restart (fine for local dev).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Supabase Auth: the anon (publishable) key, used for the email + password
# sign-in. Safe to hold server-side, but like every key here it is never
# committed — .env is gitignored. Set it (with SUPABASE_URL) to get real
# accounts; leave it blank to fall back to the offline login above.
# Accounts are invite-only: invite from the Supabase dashboard; the invited
# user sets their own password at /auth/set-password (docs/USER_SCOPING.md).
# Public signup is off.
SUPABASE_ANON_KEY=

# Set to 1 when served over HTTPS (marks the session cookie Secure).
DASHBOARD_HTTPS=0

# Set to 1 to click through the app without calling any capability: every
# run returns that page's canned `example_output`. No API key, no cost, no
# wait. A banner shows while it's on. Leave at 0 for real runs.
DASHBOARD_STUB_RUNS=0

# Optional host/port for `uv run dashboard` (defaults: 127.0.0.1:8000).
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8000
