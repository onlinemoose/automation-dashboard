# Copy to `.env` (gitignored) and fill in.

# Session-cookie signing key. Any long random string. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# The dashboard password, as a scrypt hash. Generate one:
#   uv run python -m dashboard.hashpw
DASHBOARD_PASSWORD_HASH=

# Passed through the environment to any capability that calls an LLM.
ANTHROPIC_API_KEY=

# Set to 1 when served over HTTPS (marks the session cookie Secure).
DASHBOARD_HTTPS=0

# Set to 1 to click through the app without calling any capability: every
# run returns that page's canned `example_output`. No API key, no cost, no
# wait. A banner shows while it's on. Leave at 0 for real runs.
DASHBOARD_STUB_RUNS=0

# Optional host/port for `uv run dashboard` (defaults: 127.0.0.1:8000).
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8000
